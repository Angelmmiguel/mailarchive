{
	"name": "mailarchive-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && touch build/.gitkeep",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:e2e": "vitest run --project e2e && playwright test"
	},
	"dependencies": {
		"@fontsource/geist-mono": "5.3.0",
		"@fontsource/source-sans-3": "5.3.0",
		"@noble/ciphers": "2.4.0",
		"@noble/hashes": "2.4.0",
		"@scure/base": "2.4.0",
		"@scure/bip39": "2.4.0",
		"postal-mime": "3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "30.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
